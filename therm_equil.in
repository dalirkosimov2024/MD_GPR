
units metal
atom_style atomic
boundary p p p
dimension 3

read_data init.data
#read_data therm_equil.dat

group sinwall type 1
group above type 3
group below type 4
group fluids type 3 4
group wall type 2

pair_style hybrid table linear 9999 yukawa 3.0 5.0
pair_coeff 3 3  table veff_light.table MY_POTENTIAL
pair_coeff 3 4 table veff_light.table MY_POTENTIAL
pair_coeff 4 4 table veff_light.table MY_POTENTIAL

pair_coeff 1 1 yukawa 160
pair_coeff 2 2 yukawa 160
pair_coeff 1 2 yukawa 160
pair_coeff 1 3 yukawa 160
pair_coeff 1 4 yukawa 160
pair_coeff 2 3 yukawa 160
pair_coeff 2 4 yukawa 160


delete_atoms overlap 0.001 all all

fix freeze_wall wall setforce 0.0 0.0 0.0
fix freeze_sinwall sinwall setforce 0.0 0.0 0.0


min_style cg
minimize 1.0e-10 1.0e-10 100 10000

unfix freeze_sinwall
unfix freeze_wall

fix rw sinwall rigid single force 1 off on off torque * off off off


#dump mydump all atom 1000 outputs/therm_equil.output

thermo 100
thermo_style custom step temp press pe ke etotal
log thermo.dump

# -----------------


#compute totalRDF fluids rdf 300
#fix 1 fluids ave/time 100 10 1000 c_totalRDF[*] file therm_equil_ext_total.rdf mode vector

#compute aboveRDF above rdf 300
#fix 2 above ave/time 100 10 1000 c_aboveRDF[*] file therm_equil_ext_heavy.rdf mode vector

#compute belowRDF below rdf 300
#fix 3 below ave/time 100 10 1000 c_belowRDF[*] file therm_equil_ext_light.rdf mode vector


#---------------

variable dy equal 3.0
compute ybins fluids chunk/atom bin/1d y lower ${dy} units box

fix rho fluids ave/chunk 20 1 20 ybins density/number file outputs/therm_equil_rho_y_time.dat

compute myTemp fluids temp
fix TempOut fluids ave/time 100 1 1000 c_myTemp file outputs/therm_equil_temp.dat mode scalar

compute myPress all pressure myTemp
fix PressOut all ave/time 100 10 1000 c_myPress file outputs/therm_equil_press.dat mode scalar

# -----------------
dump mydump all custom 1000 outputs/therm_equil.output id type xs ys zs vx vy vz

timestep 5e-5

velocity fluids create 150858 24680 mom yes rot no dist gaussian
fix int fluids nvt temp 150858 150858 0.01

run 20000

unfix int 
fix int fluids nve

timestep 5e-5
run 20000


write_data   outputs/therm_equil.writeout


