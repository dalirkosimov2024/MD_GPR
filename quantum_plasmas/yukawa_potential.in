# Strongly coupled Yukawa CH mixture (units: metal)

units           metal # eV, Angstrom, ps
atom_style      atomic
boundary        p m p
dimension       2

# --- User parameters ---
variable        pi equal 3.141592653589793
variable        a equal 1.06205 # Wigner-Seitz radius for total ion density [A]
variable        lambda equal 0.356 # screening length [A] (fixed)
variable        TeV equal 0.514 # ion temperature [eV]
variable        Ntot equal 154 # total number of ions
variable        fH equal 0.0 # H fraction (C fraction = 1 - fH)

# Effective ionic charges (choose your ionization states)
variable        ZC equal 6.0 # C

# --- Derived parameters ---
variable        kappa equal 1.0/${lambda} # [A^-1]
variable        A0 equal 14.3996 # e^2/(4*pi*eps0) in eV*A
variable        A_CC equal ${A0}*${ZC}*${ZC}
variable        rc equal 5.0*${lambda} # cutoff ~ 5*lambda [A]

variable        TK equal ${TeV}*11604.518 # K (for thermostat in units metal)
variable        nA3 equal 3.0/(4.0*${pi}*${a}^3.0) # total number density [A^-3]
# L = (N/n)^(1/3)  (use ^ instead of pow())
#variable L        equal "(${Ntot}/${nA3})^(1.0/3.0)"

#-----------------------------------------------------------------------------

# Define the total box where atoms will be created

lattice         hex 0.9 # hex 1 only for the inert wall
variable        Lx equal 100
region          full_box block 0 v_Lx -111 111 -0.1 0.1
create_box      3 full_box

# Create full box of inert wall atoms

create_atoms    1 region full_box
mass            1    50

# Define an inert wall that acts as a pertubation geometry 

variable        A equal 9
variable        L equal 100
variable        Y0 equal 0
variable        pi equal 3.141592653589793
variable        dl equal 1.2
variable        mode equal "v_pi/2"
variable        offset equal "2.5"

variable        below_sine atom "y<(v_A*sin(v_mode*v_pi*x/v_L+v_offset)+v_Y0-v_dl)"
variable        above_sine atom "y>(v_A*sin(v_mode*v_pi*x/v_L+v_offset)+v_Y0+v_dl)"

# Delete wall atoms that are outside the pertubed geometry

delete_atoms    variable below_sine
delete_atoms    variable above_sine


# --- Build box at the correct density ---
region          top block 0 100 10 110 0 0.1 units box
region          bottom block 0 100 -110 -10 -0.1 0.1 units box

mass            2    12.0107 # C
mass            3    3 # gives Atwood number of 0.6

print           "Carbon Yukawa mixture:"
print           "Ion number density: ${nA3} A^-3"
print           "Thomas-Fermi screening length: ${lambda} A"
print           "Yukawa cutoff: ${rc} A"
print           "Composition: C = 100%"
print           "Target temperature: ${TeV} eV"

create_atoms    2 random 3183 1 top
create_atoms    3 random 3183 1 bottom


# --- Interactions: Yukawa ---
pair_style      yukawa ${kappa} ${rc}
pair_coeff      1    1    ${A_CC} # wall - wall
pair_coeff      2    2    ${A_CC} # heavy - heavy
pair_coeff      3    3    ${A_CC} # light - light
pair_coeff      1    2    800 # wall - heavy
pair_coeff      1    3    800 # wall - light
pair_coeff      2    3    ${A_CC} # heavy - light


# Create reflective inert walls at top and bottom of box

group           wall type 1
group           fluids type 2 3
group           heavy type 2
group           light type 3

fix             rw   wall     rigid single force 1 off on off torque * off off off
velocity        wall set 0.0 0.0 0.0

fix             walllo all      wall/lj93 ylo -100 1.0 1.0 1.0
fix             wallhi all      wall/lj93 yhi 100 1.0 1.0 1.0



# --- Initialize velocities and run ---
timestep        5e-6                   # 0.2 fs; reduce if unstable
velocity        fluids create 5800 24680 mom yes rot no dist gaussian
fix             int fluids      nvt temp 5800 5800 1 # 0.02 ps thermostat time

dump            mydump all      atom 2000 yukawa_2c_carbon.lampstrj

thermo_style    custom step temp pe ke etotal press density
thermo          200
run             300000 #3e5
unfix           int
fix             int fluids      nvt temp 5800 5800 0.01 # 0.02 ps thermostat time
run             300000 #3e5


unfix           int
fix             int fluids      nvt temp 5800 5800 0.1 # 0.02 ps thermostat time

variable        ramp equal "step*5e-9"
fix             g    fluids    gravity v_ramp vector 0 -1 0
run             300000 #3e5
delete_atoms    group wall
unfix           int
fix             int  fluids   nve
run             1500000 # 1.5e6

