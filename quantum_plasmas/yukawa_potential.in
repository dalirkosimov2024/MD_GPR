# Strongly coupled Yukawa CH mixture (units: metal)

units           metal            # eV, Angstrom, ps
atom_style      atomic
boundary        p p p

# --- User parameters ---
variable pi equal 3.141592653589793
variable a        equal 0.865          # Wigner-Seitz radius for total ion density [A]
variable lambda   equal 0.3514            # screening length [A] (fixed)
variable TeV      equal 0.433             # ion temperature [eV]
variable Ntot     equal 4096              # total number of ions
variable fH       equal 0.50              # H fraction (C fraction = 1 - fH)

# Effective ionic charges (choose your ionization states)
variable ZH       equal 1.0               # H
variable ZC       equal 6.0               # C

# --- Derived parameters ---
variable kappa    equal 1.0/${lambda}     # [A^-1]
variable A0       equal 14.3996           # e^2/(4*pi*eps0) in eV*A
variable A_HH     equal ${A0}*${ZH}*${ZH}
variable A_CC     equal ${A0}*${ZC}*${ZC}
variable A_HC     equal ${A0}*${ZH}*${ZC}
variable rc       equal 5.0*${lambda}     # cutoff ~ 5*lambda [A]

variable TK       equal ${TeV}*11604.518  # K (for thermostat in units metal)
variable nA3      equal 3.0/(4.0*${pi}*${a}^3.0)    # total number density [A^-3]
# L = (N/n)^(1/3)  (use ^ instead of pow())
#variable L        equal "(${Ntot}/${nA3})^(1.0/3.0)"

variable NH       equal round(${fH}*${Ntot})
variable NC       equal ${Ntot}-${NH}


# --- Build box at the correct density ---
region          box block 0 22 0 22 0 22 units box
create_box      2 box
mass            1 1.00784                # H
mass            2 12.0107                # C

print "CH Yukawa mixture:"
print "Ion number density: ${nA3} A^-3"
print "Thomas-Fermi screening length: ${lambda} A"
print "Yukawa cutoff: ${rc} A"
print "Composition: H=${NH}, C=${NC} (fH=${fH})"
print "Target temperature: ${TeV} eV"

create_atoms    1 random ${Ntot} 12345 box
# Convert a fraction (1 - fH) of type-1 atoms to type 2 (C)
variable fC     equal 1.0-${fH}
set             type 1 type/fraction 2 ${fC} 98765

# --- Interactions: Yukawa ---
pair_style      yukawa ${kappa} ${rc}
pair_coeff      1 1 ${A_HH}
pair_coeff      2 2 ${A_CC}
pair_coeff      1 2 ${A_HC}

neighbor        0.2 bin
neigh_modify    delay 0 every 1 check yes

# --- Initialize velocities and run ---
timestep        0.00005                   # 0.2 fs; reduce if unstable
velocity        all create ${TK} 24680 mom yes rot no dist gaussian
fix             nvt all nvt temp ${TK} ${TK} 0.02   # 0.02 ps thermostat time

dump mydump all atom 200 yukawa.lampstrj

thermo_style    custom step temp pe ke etotal press density
thermo          200
run             1000


