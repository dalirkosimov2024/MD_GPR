# LJ sim for single mode RTI
# -------------------- INITIALISATION -----------------------
units           lj
dimension       2
atom_style      atomic
boundary        p m p

# -------------------- SYSTEM DEFINITION --------------------

# Define the total box where atoms will be created

lattice         hex 1 # hex 1 only for the inert wall
variable        Lx equal 100
region          full_box block -100 v_Lx -101 101 -0.1 0.1
create_box      3 full_box

# Create full box of inert wall atoms

create_atoms    1 region full_box
mass            1    5

# Define an inert wall that acts as a pertubation geometry 

variable        A equal 15.0
variable        L equal "v_Lx"
variable        Y0 equal 0
variable        pi equal 3.141592653589793
variable        dl equal 1
variable        mode equal "v_pi/4"
variable        offset equal "3*v_pi/2"

variable        below_sine atom "y<(v_A*sin(v_mode*v_pi*x/v_L+v_offset)+v_Y0-v_dl)"
variable        above_sine atom "y>(v_A*sin(v_mode*v_pi*x/v_L+v_offset)+v_Y0+v_dl)"

# Delete wall atoms that are outside the pertubed geometry

delete_atoms    variable below_sine
delete_atoms    variable above_sine

# Define regions and create heavy and light atoms 

region          top block -100 v_Lx 10 100 -0.1 0.1
region          bottom block -100 v_Lx -100 -10 -0.1 0.1

lattice         hex 0.8
create_atoms    2 region top
create_atoms    3 region bottom

mass            2    8.0
mass            3    2.0

# Establish LJ potentials 

pair_style      lj/cut 2.5
pair_coeff      1    1    1.0 1.0 # wall - wall
pair_coeff      2    2    1.0 1.0 # heavy - heavy
pair_coeff      3    3    1.0 1.0 # light - light
pair_coeff      1    2    1.0 1.5 # wall - heavy
pair_coeff      1    3    1.0 1.5 # wall - light
pair_coeff      2    3    1.0 1.0 # heavy - light

# Create reflective inert walls at top and bottom of box

group           wall type 1
group           fluids type 2 3
group           heavy type 2
group           light type 3

fix             freeze wall setforce 0.0 0.0 0.0
velocity        wall set 0.0 0.0 0.0

fix             walllo all      wall/lj93 ylo -101 1.0 1.0 1.0
fix             wallhi all      wall/lj93 yhi 101 1.0 1.0 1.0

# -------------------- Monitoring -----------------------

velocity        fluids create 0.7 12345 mom yes rot no dist gaussian # atoms begin with LJ velocity of 0.7, gaus dist
thermo          10
thermo_style    custom step etotal press pe ke temp density

# -------------------- Equilibrium run  -----------------------

dump            mydump all      atom 1000 rti2.lampstrj
timestep        0.005

fix             int  fluids   nvt temp 0.7 0.7 1 # Use Nose-Hoover heat bath, target velocity 0.7, damping rate of 1
restart         10000 restart_27.*.rst # restart file
run             100000

# -------------------- Rayleigh-Taylor run -----------------------

unfix           int
fix             int  fluids   nve # unfix thermostat and let system evolve by itself

# Induce gravity 

variable        gradient equal 3e-6
variable        gz equal "v_gradient*time" # ramp gravity gently, y=mx
fix             g    all     gravity v_gz vector 0.0 -1.0 0.0

delete_atoms    group wall
run             150000
